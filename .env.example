# Required for authenticated fixed-SKU billing top-ups.
ANBAN_BILLING_ADMIN_API_KEY=

# Required for short-lived managed runtime workload tokens (minimum 32 bytes).
ANBAN_AGENT_EXECUTION_TOKEN_SECRET=

# Managed runtime provider and canonical images. The local defaults match the
# images built by `make docker-up`; tags or digests may be used.
ANBAN_AGENT_EXECUTOR=docker
# Automatically set from server/agentpack/catalog.generated.json for local builds.
ANBAN_AGENT_PACK_CATALOG_DIGEST=
ANBAN_AGENT_IMAGE_WECHAT_ARTICLE=creator-agent-wechat-article:latest
ANBAN_AGENT_IMAGE_WECHAT_PICTURE=creator-agent-wechat-picture:latest
ANBAN_AGENT_IMAGE_SEEDNOTE=creator-agent-seednote:latest
ANBAN_AGENT_IMAGE_MONTAGE=creator-agent-montage:latest
ANBAN_AGENT_IMAGE_VIDEO_EDIT=creator-agent-video-edit:latest
ANBAN_AGENT_IMAGE_MOMENTS=creator-agent-moments:latest
ANBAN_AGENT_IMAGE_ECOMMERCE=creator-agent-ecommerce:latest
# Optional; configure before admitting content planning tasks.
ANBAN_AGENT_IMAGE_CONTENT_PLANNING=
ANBAN_AGENT_IMAGE_PROFILE_ANALYSIS=creator-agent-profile-analysis:latest
ANBAN_AGENT_IMAGE_FEEDBACK_ANALYSIS=creator-agent-feedback-analysis:latest
ANBAN_AGENT_IMAGE_WHITEBOARD_ANIMATION=creator-agent-whiteboard-animation:latest
# Build separately before enabling video replication in server config.
ANBAN_AGENT_IMAGE_HYPIT=creator-agent-hypit:latest
ANBAN_AGENT_IMAGE_LOCAL_LIFE=creator-agent-local-life:latest

# Independent per-session DSH runtime container.
ANBAN_DSH_EXECUTOR=container
ANBAN_DSH_IMAGE=creator-dsh-runtime:latest
ANBAN_DSH_NETWORK=creator-runtime-network
ANBAN_DSH_PROJECT_MEMORY_VOLUME=creator-project-memory
ANBAN_DSH_SERVER_URL=http://server:8080
ANBAN_DSH_BRIDGE_DIR=./runtime-dsh
ANBAN_DSH_BRIDGE_PATCH=./harness/dsh/project-creator.patch.yml
ANBAN_DSH_BRIDGE_MCP_URL=https://creator.anbanai.com/mcp

# Required for Studio/API session signing. Use a random private value.
ANBAN_JWT_SECRET_KEY=

# Required by the OSS storage provider configured in server/config.yaml.
ANBAN_OSS_ENDPOINT=
ANBAN_OSS_ACCESS_KEY_ID=
ANBAN_OSS_ACCESS_KEY_SECRET=

# Credentials for the Agent execution profiles declared in server/config.yaml.
# Every configured profile requires its Base URL, token, and five model envs.
# Claude control envs (effort, context, thinking, compaction, and tool search)
# may be removed from the YAML profile when the provider default is preferred.
ANBAN_DEEPSEEK_ANTHROPIC_BASE_URL=
ANBAN_DEEPSEEK_API_KEY=
# Optional Server-owned web and page search providers. Enable and select
# capabilities under search.web and search.fetch in server/config.yaml.
ANBAN_DEEPSEEK_SEARCH_ENDPOINT=https://api.deepseek.com/v1/tools/search
ANBAN_DEEPSEEK_SEARCH_API_KEY=
# Optional Doubao Global Search provider for web/image search. Enable image
# search with search.images.enabled in server/config.yaml.
ANBAN_DOUBAO_SEARCH_API_KEY=
ANBAN_SEARCH_IMAGES_ENABLED=false
ANBAN_SEARCH_IMAGES_PROVIDER=doubao
ANBAN_MOONSHOT_ANTHROPIC_BASE_URL=https://api.moonshot.cn/anthropic
ANBAN_MOONSHOT_API_KEY=
ANBAN_ZHIPU_ANTHROPIC_BASE_URL=https://open.bigmodel.cn/api/anthropic
ANBAN_ZHIPU_API_KEY=

# Required by the configured writing and understanding model routes.
MOONSHOT_API_KEY=

# Required by the configured image generation routes.
VOLCENGINE_ARK_API_KEY=
WANGCAI_OPENAI_BASE_URL=
WANGCAI_OPENAI_API_KEY=

# Required for managed video-edit tasks (Scribe is also used for editing analysis).
VIDEO_EDIT_ELEVENLABS_API_KEY=

# Optional local MySQL override. The Compose default is development-only.
MYSQL_ROOT_PASSWORD=
# Optional interview: copy matching onboarding block into Server's deployed config.yaml.
# Inject real keys via deployment Secrets; never VITE_* or Docker build arguments.
ANBAN_ONBOARDING_ENABLED=false
ANBAN_ONBOARDING_DAILY_USER_LIMIT=60
ANBAN_ONBOARDING_DAILY_GLOBAL_LIMIT=1000
ANBAN_ONBOARDING_CHAT_BASE_URL=
ANBAN_ONBOARDING_CHAT_API_KEY=
ANBAN_ONBOARDING_CHAT_MODEL=
# OpenAI-compatible multipart /audio/transcriptions provider. Not DeepSeek chat.
ANBAN_ONBOARDING_SPEECH_BASE_URL=
ANBAN_ONBOARDING_SPEECH_API_KEY=
ANBAN_ONBOARDING_SPEECH_MODEL=

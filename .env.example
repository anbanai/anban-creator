# Local credentials and machine-specific overrides only.
#
# Every non-secret default lives in server/config.example.yaml: agent images,
# DSH wiring, the OSS endpoint/bucket/region, provider base URLs, feature
# flags, and quotas. Do not repeat those defaults here. Compose forwards this
# file to the Server container and the Server expands ${VAR} references in
# server/config.yaml, so a value set here overrides the YAML default; an unset
# variable keeps it.
#
# Fill the required values below before `make docker-up` or `make server-dev`.
# Optional entries are needed only when their integration is enabled in
# server/config.yaml.

# Required for authenticated fixed-SKU billing top-ups.
ANBAN_BILLING_ADMIN_API_KEY=

# Required for short-lived managed runtime workload tokens (minimum 32 bytes).
ANBAN_AGENT_EXECUTION_TOKEN_SECRET=

# Local single-host executor. Kubernetes sets ANBAN_AGENT_EXECUTOR in
# server/Deployment.yaml; agent images are configured in server/config.yaml.
ANBAN_AGENT_EXECUTOR=docker
# Automatically set from server/agentpack/catalog.generated.json for local builds.
ANBAN_AGENT_PACK_CATALOG_DIGEST=

# RedFox integration. These credentials have separate owners and scopes:
# ANBAN_REDFOX_API_KEY is used by the Server for the existing list_trends MCP
# tool, but only when trends.provider=redfox. It is never passed to an Agent
# runtime.
# ANBAN_REDFOX_AGENT_API_KEY is used by the read-only RedFox research MCP
# Skill inside article, Seednote, viral-analysis, and content-research Agents.
# It is injected only for those task profiles and is not used by list_trends.
# Keep the two keys separate when your RedFox account supports it.
ANBAN_REDFOX_API_KEY=
ANBAN_REDFOX_AGENT_API_KEY=

# Required for Studio/API session signing. Use a random private value.
ANBAN_JWT_SECRET_KEY=

# Required by the OSS storage provider configured in server/config.yaml.
# The endpoint, bucket, region, and content-awareness settings keep their YAML
# defaults; change them in server/config.yaml instead of here.
ANBAN_OSS_ACCESS_KEY_ID=
ANBAN_OSS_ACCESS_KEY_SECRET=
# Optional public CDN/custom OSS domain. Leave empty when unused.
ANBAN_OSS_CDN_DOMAIN=
# Optional STS role for browser direct uploads. Leave empty when uploads are
# performed through the Server only.
ANBAN_OSS_STS_ROLE_ARN=
ANBAN_OSS_STS_ENDPOINT=

# Credentials for the Agent execution profiles declared in server/config.yaml.
# Provider base URLs and the other Claude control envs keep their YAML
# defaults; each configured profile still needs its provider token below.
ANBAN_DEEPSEEK_API_KEY=
# Optional Server-owned web and page search providers. Enable and select
# capabilities under search.web and search.fetch in server/config.yaml.
ANBAN_DEEPSEEK_SEARCH_API_KEY=
# Optional Doubao Global Search provider for web/image search. Enable image
# search with search.images.enabled in server/config.yaml.
ANBAN_DOUBAO_SEARCH_API_KEY=
ANBAN_MOONSHOT_API_KEY=
ANBAN_ZHIPU_API_KEY=

# Optional Server-owned trend provider. Required only when
# trends.provider=redfox in server/config.yaml.
# Endpoint defaults are defined in server/config.example.yaml.
# ANBAN_REDFOX_ENDPOINT=
ANBAN_REDFOX_API_KEY=

# Optional Agent-specific RedFox credentials. Each key is injected only into
# the matching Agent ID configured in its top-level env block. These are separate
# from the Server key used by list_trends.
ANBAN_REDFOX_AGENT_WECHAT_ARTICLE_API_KEY=
ANBAN_REDFOX_AGENT_WECHAT_PICTURE_API_KEY=
ANBAN_REDFOX_AGENT_SEEDNOTE_API_KEY=
ANBAN_REDFOX_AGENT_CONTENT_PLANNING_API_KEY=

# Required by the configured writing and understanding model routes.
MOONSHOT_API_KEY=

# Required by the configured image generation routes.
VOLCENGINE_ARK_API_KEY=
WANGCAI_OPENAI_BASE_URL=
WANGCAI_OPENAI_API_KEY=

# Required for managed video-edit tasks (Scribe is also used for editing analysis).
VIDEO_EDIT_ELEVENLABS_API_KEY=
# Server-owned key used only for talking-head-editor runtime bootstrap.
VIDEO_USE_API_KEY=

# Optional local MySQL override. The Compose default is development-only.
MYSQL_ROOT_PASSWORD=

# Optional interview. Enable and configure the onboarding block in
# server/config.yaml first; these entries only supply its endpoint, credential,
# and model name.
ANBAN_ONBOARDING_CHAT_BASE_URL=
ANBAN_ONBOARDING_CHAT_API_KEY=
ANBAN_ONBOARDING_CHAT_MODEL=
# OpenAI-compatible multipart /audio/transcriptions provider. Not DeepSeek chat.
ANBAN_ONBOARDING_SPEECH_BASE_URL=
ANBAN_ONBOARDING_SPEECH_API_KEY=
ANBAN_ONBOARDING_SPEECH_MODEL=

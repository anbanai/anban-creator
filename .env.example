# Required for authenticated fixed-SKU billing top-ups.
ANBAN_BILLING_ADMIN_API_KEY=

# Required for short-lived managed runtime workload tokens (minimum 32 bytes).
ANBAN_AGENT_EXECUTION_TOKEN_SECRET=

# Managed runtime provider and canonical images. The local defaults match the
# images built by `make docker-up`; production should use immutable digests.
ANBAN_AGENT_EXECUTOR=docker
ANBAN_AGENT_IMAGE_ARTICLE=creator-agent-article:latest
ANBAN_AGENT_IMAGE_SEEDNOTE=creator-agent-seednote:latest
ANBAN_AGENT_IMAGE_MONTAGE=creator-agent-montage:latest

# Required for Studio/API session signing. Use a random private value.
ANBAN_JWT_SECRET_KEY=

# Required by the OSS storage provider configured in server/config.yaml.
ANBAN_OSS_ENDPOINT=
ANBAN_OSS_ACCESS_KEY_ID=
ANBAN_OSS_ACCESS_KEY_SECRET=

# Optional Agent execution profile providers. DeepSeek must expose an
# Anthropic-compatible endpoint. A profile remains unavailable until all of its
# own values are configured; missing values do not prevent the Server starting.
ANBAN_DEEPSEEK_ANTHROPIC_BASE_URL=
ANBAN_DEEPSEEK_API_KEY=
ANBAN_DOUBAO_AGENT_BASE_URL=https://ark.cn-beijing.volces.com/api/compatible
ANBAN_DOUBAO_AGENT_API_KEY=
ANBAN_KIMI_API_KEY=

# Required by the configured writing and understanding model routes.
MOONSHOT_API_KEY=

# Required by the configured image generation routes.
VOLCENGINE_ARK_API_KEY=
WANGCAI_OPENAI_API_KEY=

# Optional local MySQL override. The Compose default is development-only.
MYSQL_ROOT_PASSWORD=

# Studio frontend — nginx serves the built SPA and reverse-proxies the backend.
#
# The web build's axios baseURL resolves to same-origin /api/v1
# (studio/src/lib/http-client.ts), and task streaming uses SSE over
# /api/v1/tasks/<id>/stream. So proxying /api/ covers everything. /ws is proxied
# for parity with the vite dev server (studio has no WS client today).

server {
    listen 80;
    # Image upload (cover art, reference images) exceeds nginx's 1m default.
    client_max_body_size 25m;

    # gzip the big JS/CSS/HTML bundles (Vite vendor chunks are several hundred KB
    # raw; gzip typically cuts them ~70%). nginx always gzips text/html; the list
    # below adds the rest. Already-compressed binaries (images, fonts) are skipped.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # Static frontend with SPA routing fallback. index.html is served here (not
    # under /assets/), so it is NOT cached immutably — it must be re-fetched to
    # pick up new content-hashed asset references.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Vite emits content-hashed filenames under /assets/ (e.g.
    # AuthLayout-CVWgoRWt.js); a changed bundle ships under a new URL and the old
    # one is never re-requested, so immutable caching is safe and optimal.
    location /assets/ {
        root /usr/share/nginx/html;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Backend API (REST + SSE). proxy_buffering off + long read timeout keep
    # Server-Sent Events streaming live instead of buffering chunks.
    location /api/ {
        proxy_pass http://${BACKEND_HOST}:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_read_timeout 1h;
        proxy_send_timeout 1h;
    }

    # WebSocket (parity with the vite dev proxy; unused by studio today).
    location /ws {
        proxy_pass http://${BACKEND_HOST}:8080;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 1h;
    }
}

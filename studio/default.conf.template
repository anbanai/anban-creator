# Studio frontend — nginx serves only static files and SPA routes.

# Classify the normalized path; this non-volatile map caches its first result.
map $uri $share_access_log {
    default 1;
    ~*^/share/ 0;
    ~*^/api/v1/public/shares/ 0;
}
map $share_access_log $share_robots_tag {
    default "";
    0 "noindex, nofollow";
}
map $share_access_log $share_referrer_policy {
    default "";
    0 "no-referrer";
}

server {
    listen 80;
    # Evaluate before routing so SPA redirects cannot reclassify /share/ as /index.html.
    set $original_share_access_log $share_access_log;
    access_log /var/log/nginx/access.log combined if=$original_share_access_log;

    # gzip the big JS/CSS/HTML bundles (Vite vendor chunks are several hundred KB
    # raw; gzip typically cuts them ~70%). nginx always gzips text/html; the list
    # below adds the rest. Already-compressed binaries (images, fonts) are skipped.
    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    gzip_vary on;
    gzip_proxied any;
    gzip_types
        text/plain
        text/css
        text/xml
        application/javascript
        application/json
        application/xml
        image/svg+xml;

    # Keep the HTML shell revalidated so a release cutover picks up the current
    # content-hashed asset references immediately.
    location = /index.html {
        root /usr/share/nginx/html;
        add_header Cache-Control "no-store, must-revalidate" always;
        add_header X-Robots-Tag $share_robots_tag always;
        add_header Referrer-Policy $share_referrer_policy always;
    }

    # Static frontend with SPA routing fallback.
    location / {
        root /usr/share/nginx/html;
        index index.html;
        try_files $uri $uri/ /index.html;
    }

    # Old tabs still request previous hashed URLs after a release. The image
    # inherits previous assets; missing assets must return 404, never SPA HTML.
    location /assets/ {
        root /usr/share/nginx/html;
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
        access_log off;
    }

    # Service endpoints belong to independent API / Archestra origins.
    # Reject stale callers instead of returning the SPA HTML as an API response.
    location ~ ^/(api|mcp|ws|archestra)(/|$) {
        return 404;
    }
}

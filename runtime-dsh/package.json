{
  "name": "anban-runtime-dsh",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24.22.0 <25"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "patch:dependencies": "node scripts/patch-dsh-dependencies.mjs",
    "test": "npm run patch:dependencies && bun test",
    "start": "node dist/dsh-bridge.js",
    "test:startup": "bun run build && node scripts/build-startup-harness.mjs && node test/fixtures/project-creator-start.mjs && node test/fixtures/assistant-presets-start.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis-plugin-group": "1.0.6-alpha.1",
    "@deepseek-ai/dsh-sdk-client": "file:vendor/@deepseek-ai/dsh-sdk-client",
    "@deepseek-ai/dsh-sdk-protocol": "file:vendor/@deepseek-ai/dsh-sdk-protocol",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "file:vendor/@deepseek-ai/dsh-sdk-jsonrpc-server",
    "@deepseek-ai/dsh-agent-loop": "file:vendor/@deepseek-ai/dsh-agent-loop"
  },
  "overrides": {
    "@deepseek-ai/dsh-sdk-client": "$@deepseek-ai/dsh-sdk-client",
    "@deepseek-ai/dsh-sdk-protocol": "$@deepseek-ai/dsh-sdk-protocol",
    "@deepseek-ai/dsh-sdk-jsonrpc-server": "$@deepseek-ai/dsh-sdk-jsonrpc-server",
    "fflate": "0.8.3",
    "@deepseek-ai/dsh-agent-loop": "$@deepseek-ai/dsh-agent-loop"
  },
  "devDependencies": {
    "@deepseek-ai/dsh-llm": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-llm-deepseek": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-anonymous-user-id": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-fs": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-sandbox": "0.2.2-alpha.2",
    "@deepseek-ai/dsh-tool-executor-native": "0.2.2-alpha.2",
    "@types/node": "26.6.3",
    "typescript": "7.0.2"
  },
  "allowScripts": {
    "node-pty@1.2.0-beta.15": true,
    "koffi@3.1.1": true,
    "@google/genai": false,
    "protobufjs": false,
    "@deepseek-ai/dsh-subprocess-local@0.2.2-alpha.2": true
  }
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anban Creator",
  "version": "0.1.0",
  "identifier": "ai.anban.creator.desktop",
  "build": {
    "frontendDist": "../../studio/dist",
    "beforeDevCommand": {
      "script": "make web-dev",
      "cwd": "../.."
    },
    "beforeBuildCommand": {
      "script": "make web-build",
      "cwd": "../.."
    },
    "devUrl": "http://localhost:5173"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob: https: http:; media-src 'self' blob: https: http:; style-src 'self' 'unsafe-inline'; font-src 'self' data: https:; script-src 'self' 'unsafe-inline'; connect-src 'self' https: http://localhost:* http://127.0.0.1:* ws: wss:"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "resources/bin/*",
      "resources/claude/**/*",
      "resources/claudecode/**/*"
    ],
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "11.0",
      "signingIdentity": null
    }
  }
}

FROM golang:1.26-alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/anban ./agent

FROM ghcr.io/openhands/agent-server:1.23.0-python

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git jq fontconfig fonts-noto-cjk python3 tini; \
    if ! command -v npm >/dev/null 2>&1; then \
      apt-get install -y --no-install-recommends nodejs npm; \
    fi; \
    if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then \
      apt-get install -y --no-install-recommends ffmpeg; \
    fi; \
    getent passwd 1000 >/dev/null || { echo >&2 "pinned OpenHands base must provide UID 1000"; exit 1; }; \
    getent group 1000 >/dev/null || { echo >&2 "pinned OpenHands base must provide GID 1000"; exit 1; }; \
    install -d -m 0755 -o 1000 -g 1000 /home/node; \
    rm -rf /var/lib/apt/lists/*

RUN npm install -g @anthropic-ai/claude-code

COPY --from=builder /out/anban /usr/local/bin/anban
COPY claudecode/   /anbanai/
COPY third_party/OpenMontage/ /app/third_party/OpenMontage/

ENV CLAUDE_PLUGIN_ROOT=/anbanai
ENV ANBAN_HOME_TEMPLATE=/opt/anban-home-template
ENV ANBAN_MONTAGE_SUBMODULE_PATH=/app/third_party/OpenMontage
ENV HOME=/home/node

USER 1000:1000
RUN git config --global http.version HTTP/1.1

RUN npx -y skills@latest add heygen-com/hyperframes \
        --agent claude-code \
        --skill music-to-video \
        --skill slideshow \
        --copy \
        -g \
        -y && \
    npx -y skills@latest add remotion-dev/skills \
        --agent claude-code \
        --skill remotion-best-practices \
        --copy \
        -g \
        -y

RUN claude plugin marketplace add /anbanai && \
    claude plugin install --scope user anban@anbanai

USER root
RUN set -eux; \
    install -d -m 0700 "$ANBAN_HOME_TEMPLATE/.claude/skills" "$ANBAN_HOME_TEMPLATE/.claude/plugins/cache"; \
    for skill in music-to-video slideshow remotion-best-practices; do \
      test -f "$HOME/.claude/skills/$skill/SKILL.md"; \
      install -d -m 0700 "$ANBAN_HOME_TEMPLATE/.claude/skills/$skill"; \
      cp -a "$HOME/.claude/skills/$skill/." "$ANBAN_HOME_TEMPLATE/.claude/skills/$skill/"; \
    done; \
    for file in known_marketplaces.json installed_plugins.json; do \
      test -f "$HOME/.claude/plugins/$file"; \
      cp -a "$HOME/.claude/plugins/$file" "$ANBAN_HOME_TEMPLATE/.claude/plugins/$file"; \
    done; \
    test -d "$HOME/.claude/plugins/cache/anbanai"; \
    cp -a "$HOME/.claude/plugins/cache/anbanai" "$ANBAN_HOME_TEMPLATE/.claude/plugins/cache/anbanai"; \
    if [ -n "$(find "$ANBAN_HOME_TEMPLATE" -type l -print -quit)" ]; then \
      echo >&2 "home template must not contain symlinks"; \
      exit 1; \
    fi; \
    chown -R root:root "$ANBAN_HOME_TEMPLATE"; \
    chmod -R a=rX "$ANBAN_HOME_TEMPLATE"

USER 1000:1000
WORKDIR /workspace

ENTRYPOINT ["tini", "--"]
CMD ["sleep", "infinity"]

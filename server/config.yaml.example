# AnbanWriter Online Service Configuration
# Copy this file to config.yaml and adjust values as needed.
# All fields can also be set via ANBAN_SERVER_ prefixed environment variables
# (e.g. ANBAN_SERVER_DATABASE_DSN, ANBAN_SERVER_JWT_SECRET_KEY).

# ---------------------------------------------------------------------------
# Server: HTTP listen configuration
# ---------------------------------------------------------------------------
server:
  port: 8080            # Listen port. Override with ANBAN_SERVER_PORT or -port flag.
  host: "0.0.0.0"       # Listen host. Use "127.0.0.1" to restrict to localhost.

# ---------------------------------------------------------------------------
# Database: MySQL connection
# Required. The server will not start without a valid DSN.
# Graceful degradation: if MySQL is unreachable at startup, the server logs an
# error and continues running in degraded mode (no data persistence).
# ---------------------------------------------------------------------------
database:
  dsn: "root:anbanwriter_dev@tcp(localhost:3306)/anbanwriter?charset=utf8mb4&parseTime=True&loc=Local"
  max_open_conns: 10        # Maximum open connections to the database.
  max_idle_conns: 5         # Maximum idle connections kept in the pool.
  conn_max_lifetime: 3600   # Connection maximum lifetime in seconds.

# ---------------------------------------------------------------------------
# Redis: Cache and async task queue (Asynq)
# Optional. If Redis is unreachable, the server falls back to in-process
# goroutine-based task execution. Rate limiting is also skipped when Redis
# is unavailable.
# ---------------------------------------------------------------------------
redis:
  addr: "localhost:6379"    # Redis server address (host:port).
  password: ""              # Redis password. Set via ANBAN_SERVER_REDIS_PASSWORD.
  db: 0                     # Redis database number.

# ---------------------------------------------------------------------------
# JWT: JSON Web Token authentication
# Required. secret_key must be set (via config or ANBAN_SERVER_JWT_SECRET_KEY).
# ---------------------------------------------------------------------------
jwt:
  secret_key: ""            # HMAC signing key. MUST be set in production.
                             # Generate with: openssl rand -hex 32
  access_expiry: "24h"      # Access token validity duration.
  refresh_expiry: "168h"    # Refresh token validity duration (7 days).

# ---------------------------------------------------------------------------
# WeChat: Optional WeChat mini-program login integration
# Optional. If app_id and app_secret are empty, WeChat login is disabled.
# ---------------------------------------------------------------------------
wechat:
  app_id: ""                # WeChat Mini Program AppID.
  app_secret: ""            # WeChat Mini Program AppSecret.

# ---------------------------------------------------------------------------
# Storage: File storage configuration
# Supports "oss" (Alibaba Cloud OSS) or "local" (filesystem).
# Default is "local" for development.
# ---------------------------------------------------------------------------
storage:
  provider: "local"
  endpoint: ""                # OSS endpoint, e.g. "oss-cn-hangzhou.aliyuncs.com"
  access_key_id: ""           # Alibaba Cloud AccessKey ID
  access_key_secret: ""       # Alibaba Cloud AccessKey Secret
  bucket_name: ""             # OSS bucket name
  region: ""                  # OSS region, e.g. "cn-hangzhou"
  custom_domain: ""           # Optional CDN domain for public file URLs
  local_data_dir: "./data/files"  # Local provider: where to store files

# ---------------------------------------------------------------------------
# MCP: Model Context Protocol endpoint configuration
# Optional. The MCP endpoint (/api/v1/mcp/tools) supports two auth methods:
#   1. JWT Bearer token (standard user authentication)
#   2. X-API-Key header (set api_key here to enable)
#
# When api_key is empty, only JWT authentication is available.
# When api_key is set, Claude Code can connect using the X-API-Key header.
# ---------------------------------------------------------------------------
mcp:
  api_key: ""               # Server-level API key for Claude Code integration.
                             # Set via ANBAN_SERVER_MCP_API_KEY env var.
                             # Generate with: openssl rand -hex 32

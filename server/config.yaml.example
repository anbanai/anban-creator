server:
  port: 8080
  host: "0.0.0.0"

database:
  dsn: "root:anbanwriter_dev@tcp(localhost:3306)/anbanwriter?charset=utf8mb4&parseTime=True&loc=Local"
  max_open_conns: 10
  max_idle_conns: 5
  conn_max_lifetime: 3600

redis:
  addr: "localhost:6379"
  password: ""
  db: 0

jwt:
  secret_key: ""  # Set via ANBAN_SERVER_JWT_SECRET_KEY env var
  access_expiry: "24h"
  refresh_expiry: "168h"

wechat:
  app_id: ""
  app_secret: ""

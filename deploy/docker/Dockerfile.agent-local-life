FROM node:24.22.0-bookworm-slim AS builder

WORKDIR /app/runtime-claude
COPY runtime-claude/package.json runtime-claude/package-lock.json ./
RUN npm ci
COPY runtime-claude/ ./
RUN npm run build && \
    grep -Fq 'X-Anban-Agent-Pack-Catalog-Digest' dist/bootstrap.js && \
    npm prune --omit=dev && test -d node_modules/@anthropic-ai/claude-agent-sdk

FROM node:24.22.0-bookworm-slim

ARG MONEYPRINTERTURBO_REPO=https://github.com/harry0703/MoneyPrinterTurbo.git
ARG MONEYPRINTERTURBO_REF=e25326e37d15002404778973e48215afaa57fde8

USER root
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git jq ffmpeg fontconfig fonts-noto-cjk fonts-noto-color-emoji python3 python3-venv tini; \
    getent passwd 1000 >/dev/null; \
    getent group 1000 >/dev/null; \
    install -d -m 0755 -o 1000 -g 1000 /home/node; \
    install -d -m 0770 -o 1000 -g 1000 /workspace; \
    install -d -m 0750 -o 1000 -g 1000 /workspace/.claude; \
    install -d -m 0700 -o 1000 -g 1000 /run/secrets/anban; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/moneyprinterturbo
RUN git init . \
    && git remote add origin "$MONEYPRINTERTURBO_REPO" \
    && git fetch --depth 1 origin "$MONEYPRINTERTURBO_REF" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "$MONEYPRINTERTURBO_REF" \
    && printf '%s\n' "$MONEYPRINTERTURBO_REF" > .anban-source-revision \
    && python3 -m venv /opt/moneyprinterturbo-venv \
    && /opt/moneyprinterturbo-venv/bin/pip install --no-cache-dir -r requirements.txt \
    && rm -rf .git /root/.cache/pip

COPY deploy/docker/local-life-mpt-bridge.py /usr/local/bin/local-life-mpt
COPY harness/ /anbanai/
COPY deploy/docker/anban-agent-launcher /usr/local/bin/anban
COPY --from=builder /app/runtime-claude/node_modules /app/runtime-claude/node_modules
COPY --from=builder /app/runtime-claude/dist /app/runtime-claude/dist
RUN set -eux; \
    if [ -n "$(find /anbanai -type l -print -quit)" ]; then echo >&2 "/anbanai must not contain symlinks"; exit 1; fi; \
    chown -R root:root /anbanai /app/runtime-claude /opt/moneyprinterturbo /opt/moneyprinterturbo-venv; \
    chmod -R a=rX /anbanai /app/runtime-claude /opt/moneyprinterturbo /opt/moneyprinterturbo-venv; \
    chmod 0755 /usr/local/bin/anban /usr/local/bin/local-life-mpt

ENV CLAUDE_PLUGIN_ROOT=/anbanai
ENV MPT_ROOT=/opt/moneyprinterturbo
ENV MPT_HOME=/workspace/mpt
ENV PATH="/opt/moneyprinterturbo-venv/bin:${PATH}"
ENV HOME=/home/node

USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "anban"]
CMD ["job"]

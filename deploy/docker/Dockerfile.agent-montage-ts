FROM node:bookworm-slim AS builder

WORKDIR /app/anban-agent
COPY agent-ts/package.json agent-ts/package-lock.json ./
RUN npm ci
COPY agent-ts/ ./
RUN npm run build && npm prune --omit=dev && test -d node_modules/@anthropic-ai/claude-agent-sdk

FROM ghcr.io/openhands/agent-server:latest-python

USER root
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git jq fontconfig fonts-noto-cjk python3 python3-venv tini; \
    if ! command -v npm >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1 || ! node -e 'process.exit(Number(process.versions.node.split(".")[0]) >= 22 ? 0 : 1)'; then \
      curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource-setup.sh; bash /tmp/nodesource-setup.sh; apt-get install -y --no-install-recommends nodejs; rm -f /tmp/nodesource-setup.sh; \
    fi; \
    if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then apt-get install -y --no-install-recommends ffmpeg; fi; \
    getent passwd 1000 >/dev/null || { echo >&2 "OpenHands base must provide UID 1000"; exit 1; }; \
    getent group 1000 >/dev/null || { echo >&2 "OpenHands base must provide GID 1000"; exit 1; }; \
    install -d -m 0755 -o 1000 -g 1000 /home/node /run/secrets/anban; \
    rm -rf /var/lib/apt/lists/*

COPY third_party/OpenMontage/ /opt/montage-template/
ENV OPENMONTAGE_VENV=/opt/openmontage-venv
RUN set -eux; \
    python3 -m venv "$OPENMONTAGE_VENV"; \
    "$OPENMONTAGE_VENV/bin/pip" install --no-cache-dir -r /opt/montage-template/requirements.txt; \
    cd /opt/montage-template/remotion-composer && npm ci; \
    chown -R root:root /opt/montage-template "$OPENMONTAGE_VENV"; \
    chmod -R a=rX /opt/montage-template "$OPENMONTAGE_VENV"

COPY --from=builder /app/anban-agent/node_modules /app/anban-agent/node_modules
COPY --from=builder /app/anban-agent/dist /app/anban-agent/dist
COPY plugins/ /anbanai/
COPY deploy/docker/anban-ts-launcher /usr/local/bin/anban
RUN set -eux; \
    if [ -n "$(find /anbanai -type l -print -quit)" ]; then echo >&2 "/anbanai must not contain symlinks"; exit 1; fi; \
    chown -R root:root /anbanai /app/anban-agent; \
    chmod -R a=rX /anbanai /app/anban-agent; \
    chmod 0755 /usr/local/bin/anban

ENV CLAUDE_PLUGIN_ROOT=/anbanai
ENV ANBAN_MONTAGE_TEMPLATE_PATH=/opt/montage-template
ENV HOME=/home/node
ENV PATH="${OPENMONTAGE_VENV}/bin:${PATH}"

USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "anban"]
CMD ["job"]

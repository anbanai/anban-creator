{
  "format": "hypit.runtime-local@1",
  "dataRoot": "/tmp/.hypit-build",
  "credentials": {"env": {"use": "@hypit/credential-store-env"}},
  "endpoints": {
    "media.local": {"use": "@hypit/media-local"},
    "html.local": {
      "use": "@hypit/provider-html-local",
      "config": {"workers": 2, "defaultConcurrency": 1, "browserGpu": "software"}
    }
  },
  "bindings": {}
}

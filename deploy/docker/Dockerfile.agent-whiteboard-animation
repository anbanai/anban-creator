FROM node:24-bookworm-slim AS builder

WORKDIR /app/anban-agent
COPY agent-ts/package.json agent-ts/package-lock.json ./
RUN npm ci
COPY agent-ts/ ./
RUN npm run build && npm prune --omit=dev && test -d node_modules/@anthropic-ai/claude-agent-sdk

FROM node:24-bookworm-slim

ARG WHITEBOARD_ANIMATION_REPO=https://github.com/geeklee/srt-whiteboard-animation.git
ARG WHITEBOARD_ANIMATION_REF=696a7243c0e6ffb6827676e539c2ca5ebae2bf6b

USER root
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates git ffmpeg python3 python3-venv tini; \
    getent passwd 1000 >/dev/null || { echo >&2 "Node base must provide UID 1000"; exit 1; }; \
    getent group 1000 >/dev/null || { echo >&2 "Node base must provide GID 1000"; exit 1; }; \
    install -d -m 0770 -o 1000 -g 1000 /workspace; \
    install -d -m 0750 -o 1000 -g 1000 /workspace/.claude; \
    install -d -m 0700 -o 1000 -g 1000 /run/secrets/anban; \
    rm -rf /var/lib/apt/lists/*

WORKDIR /opt/whiteboard-animation
RUN git init . \
    && git remote add origin "$WHITEBOARD_ANIMATION_REPO" \
    && git fetch --depth 1 origin "$WHITEBOARD_ANIMATION_REF" \
    && git checkout --detach FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "$WHITEBOARD_ANIMATION_REF" \
    && test -f LICENSE \
    && printf '%s\n' "$WHITEBOARD_ANIMATION_REF" > /opt/whiteboard-animation/.anban-source-revision \
    && rm -rf .git

ENV WHITEBOARD_ANIMATION_VENV=/opt/whiteboard-animation-venv
RUN set -eux; \
    python3 -m venv "$WHITEBOARD_ANIMATION_VENV"; \
    "$WHITEBOARD_ANIMATION_VENV/bin/pip" install --no-cache-dir \
      opencv-python-headless==4.10.0.84 numpy==1.26.4 av==13.1.0 Pillow==11.1.0; \
    "$WHITEBOARD_ANIMATION_VENV/bin/python" -c "import av, cv2, numpy, PIL"; \
    "$WHITEBOARD_ANIMATION_VENV/bin/python" /opt/whiteboard-animation/scripts/parse_srt.py --help >/dev/null; \
    test -s /opt/whiteboard-animation/assets/drawing-hand.png; \
    chown -R root:root /opt/whiteboard-animation "$WHITEBOARD_ANIMATION_VENV"; \
    chmod -R a=rX /opt/whiteboard-animation "$WHITEBOARD_ANIMATION_VENV"

COPY --from=builder /app/anban-agent/node_modules /app/anban-agent/node_modules
COPY --from=builder /app/anban-agent/dist /app/anban-agent/dist
COPY harness/ /anbanai/
COPY deploy/docker/anban-agent-launcher /usr/local/bin/anban
RUN set -eux; \
    if [ -n "$(find /anbanai -type l -print -quit)" ]; then echo >&2 "/anbanai must not contain symlinks"; exit 1; fi; \
    chown -R root:root /anbanai /app/anban-agent; \
    chmod -R a=rX /anbanai /app/anban-agent; \
    chmod 0755 /usr/local/bin/anban

ENV CLAUDE_PLUGIN_ROOT=/anbanai
ENV HOME=/home/node
ENV PATH="${WHITEBOARD_ANIMATION_VENV}/bin:${PATH}"

USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "anban"]
CMD ["job"]

# syntax=docker/dockerfile:1.7

ARG OPENMONTAGE_RUNTIME_IMAGE=creator-openmontage-runtime:latest

FROM node:bookworm-slim AS builder

WORKDIR /app/anban-agent
COPY agent-ts/package.json agent-ts/package-lock.json ./
RUN npm ci
COPY agent-ts/ ./
RUN npm run build && npm prune --omit=dev && test -d node_modules/@anthropic-ai/claude-agent-sdk

FROM ${OPENMONTAGE_RUNTIME_IMAGE}

USER root
RUN set -eux; \
    getent passwd 1000 >/dev/null || { echo >&2 "OpenHands base must provide UID 1000"; exit 1; }; \
    getent group 1000 >/dev/null || { echo >&2 "OpenHands base must provide GID 1000"; exit 1; }; \
    test -f /opt/montage-template/.anban-source-revision; \
    test -x /opt/openmontage-venv/bin/python; \
    install -d -m 0755 -o 1000 -g 1000 /home/node; \
    install -d -m 0700 -o 1000 -g 1000 /run/secrets/anban

COPY --from=builder /app/anban-agent/node_modules /app/anban-agent/node_modules
COPY --from=builder /app/anban-agent/dist /app/anban-agent/dist
COPY plugins/ /anbanai/
COPY deploy/docker/anban-agent-launcher /usr/local/bin/anban
RUN set -eux; \
    if [ -n "$(find /anbanai -type l -print -quit)" ]; then echo >&2 "/anbanai must not contain symlinks"; exit 1; fi; \
    chown -R root:root /anbanai /app/anban-agent; \
    chmod -R a=rX /anbanai /app/anban-agent; \
    chmod 0755 /usr/local/bin/anban

ENV CLAUDE_PLUGIN_ROOT=/anbanai
ENV ANBAN_MONTAGE_TEMPLATE_PATH=/opt/montage-template
ENV OPENMONTAGE_VENV=/opt/openmontage-venv
ENV HOME=/home/node
ENV PATH="${OPENMONTAGE_VENV}/bin:${PATH}"

USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "anban"]
CMD ["job"]

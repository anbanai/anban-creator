FROM golang:alpine AS builder

WORKDIR /src

COPY go.mod go.sum ./
COPY third_party/claude-agent-sdk-go/go.mod ./third_party/claude-agent-sdk-go/go.mod
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -ldflags="-s -w" -o /out/anban ./agent

FROM ghcr.io/openhands/agent-server:latest-python

USER root

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git jq fontconfig fonts-noto-cjk python3 python3-venv tini; \
    if ! command -v npm >/dev/null 2>&1 || ! command -v node >/dev/null 2>&1 || ! node -e 'const [major, minor] = process.versions.node.split(".").map(Number); process.exit(major > 20 || (major === 20 && minor >= 11) ? 0 : 1)'; then \
      curl -fsSL https://deb.nodesource.com/setup_22.x -o /tmp/nodesource-setup.sh; \
      bash /tmp/nodesource-setup.sh; \
      apt-get install -y --no-install-recommends nodejs; \
      rm -f /tmp/nodesource-setup.sh; \
    fi; \
    if ! command -v ffmpeg >/dev/null 2>&1 || ! command -v ffprobe >/dev/null 2>&1; then \
      apt-get install -y --no-install-recommends ffmpeg; \
    fi; \
    getent passwd 1000 >/dev/null || { echo >&2 "OpenHands base must provide UID 1000"; exit 1; }; \
    getent group 1000 >/dev/null || { echo >&2 "OpenHands base must provide GID 1000"; exit 1; }; \
    install -d -m 0755 -o 1000 -g 1000 /home/node; \
    rm -rf /var/lib/apt/lists/*

ARG CLAUDE_CODE_VERSION=2.1.208
RUN npm install -g "@anthropic-ai/claude-code@${CLAUDE_CODE_VERSION}" && \
    claude --version && \
    npm cache clean --force && \
    rm -rf /root/.npm

COPY --from=builder /out/anban /usr/local/bin/anban
COPY plugins/ /anbanai/
COPY third_party/OpenMontage/ /opt/montage-template/

ENV OPENMONTAGE_VENV=/opt/openmontage-venv

RUN set -eux; \
    python3 -m venv "$OPENMONTAGE_VENV"; \
    "$OPENMONTAGE_VENV/bin/pip" install --no-cache-dir -r /opt/montage-template/requirements.txt; \
    test -f /opt/montage-template/remotion-composer/package-lock.json; \
    cd /opt/montage-template/remotion-composer; \
    npm ci; \
    cd /opt/montage-template; \
    "$OPENMONTAGE_VENV/bin/python" -c "from tools.tool_registry import registry; registry.discover(); summary = registry.provider_menu_summary(); assert isinstance(summary, dict)"; \
    "$OPENMONTAGE_VENV/bin/python" -c "from lib.pipeline_loader import load_pipeline; manifest = load_pipeline('cinematic'); assert manifest.get('name') or manifest.get('display_name')"; \
    npm cache clean --force; \
    rm -rf /root/.npm; \
    chown -R root:root /opt/montage-template "$OPENMONTAGE_VENV"; \
    chmod -R a=rX /opt/montage-template "$OPENMONTAGE_VENV"

RUN set -eux; \
    if [ -n "$(find /anbanai -type l -print -quit)" ]; then \
      echo >&2 "/anbanai must not contain symlinks"; \
      exit 1; \
    fi; \
    chown -R root:root /anbanai; \
    chmod -R a=rX /anbanai

ENV CLAUDE_PLUGIN_ROOT=/anbanai
ENV ANBAN_HOME_TEMPLATE=/opt/anban-home-template
ENV ANBAN_MONTAGE_TEMPLATE_PATH=/opt/montage-template
ENV HOME=/home/node
ENV PATH="${OPENMONTAGE_VENV}/bin:${PATH}"

USER 1000:1000
RUN git config --global http.version HTTP/1.1

RUN claude plugin marketplace add /anbanai && \
    claude plugin install --scope user anban@anbanai

USER root
RUN set -eux; \
    install -d -m 0700 "$ANBAN_HOME_TEMPLATE/.claude/skills" "$ANBAN_HOME_TEMPLATE/.claude/plugins/cache"; \
    for file in known_marketplaces.json installed_plugins.json; do \
      test -f "$HOME/.claude/plugins/$file"; \
      cp -a "$HOME/.claude/plugins/$file" "$ANBAN_HOME_TEMPLATE/.claude/plugins/$file"; \
    done; \
    test -d "$HOME/.claude/plugins/cache/anbanai"; \
    cp -a "$HOME/.claude/plugins/cache/anbanai" "$ANBAN_HOME_TEMPLATE/.claude/plugins/cache/anbanai"; \
    if [ -n "$(find "$ANBAN_HOME_TEMPLATE" -type l -print -quit)" ]; then \
      echo >&2 "home template must not contain symlinks"; \
      exit 1; \
    fi; \
    chown -R root:root "$ANBAN_HOME_TEMPLATE"; \
    chmod -R a=rX "$ANBAN_HOME_TEMPLATE"; \
    install -d -m 0700 -o 1000 -g 1000 /run/secrets/anban

USER 1000:1000
WORKDIR /workspace

ENTRYPOINT ["tini", "--", "anban"]
CMD ["job"]

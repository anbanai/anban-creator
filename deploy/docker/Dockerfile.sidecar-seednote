# syntax=docker/dockerfile:1.7

FROM golang:1.24 AS source
ARG SEEDNOTE_REPO=https://github.com/xpzouying/xiaohongshu-mcp.git
ARG SEEDNOTE_REF=main
WORKDIR /src

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git && rm -rf /var/lib/apt/lists/*
RUN git init . \
    && git remote add origin "$SEEDNOTE_REPO" \
    && git fetch --depth 1 origin "$SEEDNOTE_REF" \
    && git checkout --detach FETCH_HEAD

FROM source AS builder
ENV GOPROXY=https://goproxy.cn,direct \
    GOSUMDB=sum.golang.google.cn
ARG VERSION=dev
RUN go mod download
RUN CGO_ENABLED=0 GOOS=linux GOARCH=amd64 go build -ldflags="-s -w -X main.version=${VERSION}" -o /out/app .

FROM ubuntu:22.04
ENV TZ=Asia/Shanghai
RUN ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone
WORKDIR /app
RUN apt-get update && apt-get install -y ca-certificates wget gnupg && \
    sed -i 's|http://archive.ubuntu.com|https://mirrors.aliyun.com|g' /etc/apt/sources.list && \
    sed -i 's|http://security.ubuntu.com|https://mirrors.aliyun.com|g' /etc/apt/sources.list && \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates curl fonts-liberation fonts-noto-color-emoji fonts-unifont fonts-freefont-ttf fonts-wqy-zenhei \
    libasound2 libatk-bridge2.0-0 libatk1.0-0 libc6 libcairo2 libcairo-gobject2 libcups2 libdbus-1-3 libdrm2 \
    libexpat1 libfontconfig1 libgdk-pixbuf-2.0-0 libgbm1 libgcc1 libglib2.0-0 libgtk-3-0 libnspr4 libnss3 \
    libpango-1.0-0 libpangocairo-1.0-0 libstdc++6 libx11-6 libx11-xcb1 libxcb1 libxcomposite1 libxcursor1 \
    libxdamage1 libxext6 libxfixes3 libxi6 libxkbcommon0 libxrandr2 libxrender1 libxshmfence1 libxss1 libxtst6 \
    lsb-release tini wget xdg-utils xz-utils && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /app/data/home /app/data/config /app/images && chmod -R 777 /app/data /app/images
ENV XDG_CACHE_HOME=/app/cache
COPY --from=source /src/browser/browser_version.txt /tmp/browser_version.txt
RUN VER="$(cat /tmp/browser_version.txt | tr -d '[:space:]')" && \
    BASE="https://cdn.one-world.ai/browsers/${VER}" && \
    BROWSER_DIR="${XDG_CACHE_HOME}/xiaohongshu-mcp/browser/${VER}" && \
    mkdir -p "${BROWSER_DIR}" && \
    curl -fsSL -o /tmp/browser.tar.xz "${BASE}/linux-x64.tar.xz" && \
    curl -fsSL "${BASE}/SHA256SUMS" | grep " linux-x64.tar.xz$" | awk '{print $1"  /tmp/browser.tar.xz"}' | sha256sum -c - && \
    tar -xJf /tmp/browser.tar.xz -C "${BROWSER_DIR}" --strip-components=1 && \
    rm /tmp/browser.tar.xz /tmp/browser_version.txt && \
    test -x "${BROWSER_DIR}/chrome" && chmod -R 755 /app/cache

COPY --from=builder /out/app .
ENV HOME=/app/data/home \
    XDG_CONFIG_HOME=/app/data/config
EXPOSE 18060
ENTRYPOINT ["/usr/bin/tini", "-s", "--"]
CMD ["./app"]

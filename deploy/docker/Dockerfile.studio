# syntax=docker/dockerfile:1.7
#
# Multi-stage build for the Studio frontend with the repository root as its
# build context. deploy/docker/Dockerfile.studio.dockerignore intentionally includes only
# the Studio source tree because the root .dockerignore excludes studio/.
#
# dist/ is gitignored, so the production bundle must be built inside the image
# (no dependency on a host-built dist). Stage 1 compiles with Bun (tsc typecheck
# + vite build -> dist/); stage 2 serves the static output with nginx and
# reverse-proxies /api + /ws to the backend compose service.

# Production updates MUST use the active Studio image digest here. Carry its
# hashed assets forward so already-open tabs keep working after the cutover.
# The default supports the first install/local builds (no previous Studio).
ARG STUDIO_PREVIOUS_IMAGE=nginx:alpine
FROM ${STUDIO_PREVIOUS_IMAGE} AS previous
USER root
RUN mkdir -p /usr/share/nginx/html/assets

# Stage 1: build the production bundle.
FROM crpi-671lgv9lrdyll4t9.cn-chengdu.personal.cr.aliyuncs.com/bx_anbanai/oven-bun:latest AS build
WORKDIR /app

# Cache dependency install. --frozen-lockfile makes the build reproducible and
# fails fast if bun.lock drifts from package.json, rather than silently resolving
# a different tree. Keep bun.lock committed and in sync with package.json.
COPY studio/package.json studio/bun.lock ./
RUN bun install --frozen-lockfile

# Copy the rest of the source and build.
COPY studio/ .
ARG VITE_API_BASE_URL=/api/v1
ENV VITE_API_BASE_URL=${VITE_API_BASE_URL}
ARG STUDIO_COMMIT_SHA
ENV STUDIO_COMMIT_SHA=${STUDIO_COMMIT_SHA}
ENV STUDIO_REQUIRE_BUILD_COMMIT=1
RUN bun run build

# Stage 2: serve the static bundle with nginx.
FROM crpi-671lgv9lrdyll4t9.cn-chengdu.personal.cr.aliyuncs.com/bx_anbanai/nginx:alpine

# Docker and ACK use HTTP port 8080 for the internal backend Service.
# ACK overrides the host; public TLS terminates at Ingress.
ENV BACKEND_HOST=server
ENV BACKEND_SCHEME=http
ENV BACKEND_PORT=8080

# Archestra web app upstream. The loopback default lets a local image start
# without an Archestra service; ACK points these at the Archestra Service and
# the public hostname it is served on.
ENV ARCHESTRA_HOST=127.0.0.1
ENV ARCHESTRA_PORT=3000
ENV ARCHESTRA_PUBLIC_SCHEME=http
ENV ARCHESTRA_PUBLIC_HOST=archestra.localhost

# nginx config reverse-proxies /api (incl. SSE) and /ws to the backend.
COPY studio/default.conf.template /etc/nginx/templates/default.conf.template

COPY --from=previous /usr/share/nginx/html/assets /usr/share/nginx/html/assets
COPY --from=build /app/dist /usr/share/nginx/html
ARG STUDIO_PREVIOUS_IMAGE
RUN printf '%s\n' "$STUDIO_PREVIOUS_IMAGE" > /usr/share/nginx/html/previous-image.txt

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]

FROM node:24.22.0-bookworm-slim AS builder
WORKDIR /app/runtime-claude
COPY runtime-claude/package.json runtime-claude/package-lock.json ./
RUN npm ci
COPY runtime-claude/ ./
RUN npm run build && npm prune --omit=dev

FROM node:24.22.0-bookworm-slim
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl git ffmpeg python3 python3-venv tini && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/video-use
ARG VIDEO_USE_REPO=https://github.com/browser-use/video-use.git
ARG VIDEO_USE_REF=43cfc566833548093455c9d4a46bd69913b7e552
ARG AUTO_EDITOR_VERSION=29.3.1
ARG HYPERFRAMES_VERSION=0.8.214
RUN git init . && git remote add origin "$VIDEO_USE_REPO" && git fetch --depth 1 origin "$VIDEO_USE_REF" && git checkout --detach FETCH_HEAD && test "$(git rev-parse HEAD)" = "$VIDEO_USE_REF" && printf '%s\n' "$VIDEO_USE_REF" > .anban-source-revision && rm -rf .git
RUN set -eux; \
    python3 -m venv /opt/video-use-venv; \
    /opt/video-use-venv/bin/pip install --no-cache-dir -e /opt/video-use; \
    /opt/video-use-venv/bin/pip install --no-cache-dir "auto-editor==${AUTO_EDITOR_VERSION}"; \
    test "$(uname -m)" = x86_64; \
    auto_editor_binary="$(/opt/video-use-venv/bin/python -c 'import auto_editor; from pathlib import Path; print(Path(auto_editor.__file__).parent / "bin" / "auto-editor")')"; \
    install -d "$(dirname "$auto_editor_binary")"; \
    curl --fail --location --retry 5 --retry-all-errors --retry-delay 2 "https://github.com/WyattBlue/auto-editor/releases/download/${AUTO_EDITOR_VERSION}/auto-editor-linux-x86_64" --output "$auto_editor_binary"; \
    chmod 0755 "$auto_editor_binary"; \
    test "$(/opt/video-use-venv/bin/python -c 'import importlib.metadata as m; print(m.version("auto-editor"))')" = "$AUTO_EDITOR_VERSION"; \
    /opt/video-use-venv/bin/auto-editor --version >/dev/null; \
    /opt/video-use-venv/bin/python -m compileall -q /opt/video-use/helpers; \
    for helper in transcribe.py transcribe_batch.py pack_transcripts.py timeline_view.py grade.py render.py; do \
      /opt/video-use-venv/bin/python "/opt/video-use/helpers/$helper" --help >/dev/null; \
    done
RUN npm install --global --omit=dev "hyperframes@${HYPERFRAMES_VERSION}" && \
    test "$(hyperframes --version)" = "$HYPERFRAMES_VERSION"
RUN install -d -m 0770 -o 1000 -g 1000 /workspace /workspace/.claude /run/secrets/anban
COPY --from=builder /app/runtime-claude/node_modules /app/runtime-claude/node_modules
COPY --from=builder /app/runtime-claude/dist /app/runtime-claude/dist
COPY harness/ /anbanai/
COPY deploy/docker/anban-agent-launcher /usr/local/bin/anban
RUN set -eux; \
    skill=/anbanai/skills/erduo-broll-loop-engineering/SKILL.md; \
    test -s "$skill"; \
    grep -Fq 'HyperFrames `0.8.214`' "$skill"; \
    grep -Fq 'HyperFrames lint' "$skill"; \
    grep -Fq 'aesthetic review' "$skill"; \
    sound_skill=/anbanai/skills/talking-head-sound-design/SKILL.md; \
    test -s "$sound_skill"; \
    test -s /anbanai/skills/talking-head-sound-design/assets/sfx/manifest.json; \
    python3 /anbanai/skills/talking-head-sound-design/scripts/sound_pass.py --help >/dev/null; \
    chown -R root:root /anbanai /app/runtime-claude; \
    chmod -R a=rX /anbanai /app/runtime-claude; \
    chmod 0755 /usr/local/bin/anban
ENV CLAUDE_PLUGIN_ROOT=/anbanai ANBAN_VIDEO_USE_ROOT=/opt/video-use PATH=/opt/video-use-venv/bin:$PATH
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "anban"]
CMD ["job"]

FROM node:24.22.0-bookworm-slim AS builder
WORKDIR /app/runtime-claude
COPY runtime-claude/package.json runtime-claude/package-lock.json ./
RUN npm ci
COPY runtime-claude/ ./
RUN npm run build && npm prune --omit=dev

FROM node:24.22.0-bookworm-slim
USER root
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates git ffmpeg python3 python3-venv tini && rm -rf /var/lib/apt/lists/*
WORKDIR /opt/video-use
ARG VIDEO_USE_REPO=https://github.com/browser-use/video-use.git
ARG VIDEO_USE_REF=43cfc566833548093455c9d4a46bd69913b7e552
RUN git init . && git remote add origin "$VIDEO_USE_REPO" && git fetch --depth 1 origin "$VIDEO_USE_REF" && git checkout --detach FETCH_HEAD && test "$(git rev-parse HEAD)" = "$VIDEO_USE_REF" && printf '%s\n' "$VIDEO_USE_REF" > .anban-source-revision && rm -rf .git
RUN python3 -m venv /opt/video-use-venv && /opt/video-use-venv/bin/pip install --no-cache-dir -e /opt/video-use
RUN /opt/video-use-venv/bin/pip install --no-cache-dir auto-editor==28.1.0
RUN install -d -m 0770 -o 1000 -g 1000 /workspace /workspace/.claude /run/secrets/anban
COPY --from=builder /app/runtime-claude/node_modules /app/runtime-claude/node_modules
COPY --from=builder /app/runtime-claude/dist /app/runtime-claude/dist
COPY harness/ /anbanai/
COPY deploy/docker/anban-agent-launcher /usr/local/bin/anban
RUN set -eux; \
    skill=/anbanai/skills/erduo-broll-loop-engineering/SKILL.md; \
    test -s "$skill"; \
    grep -Fq 'HyperFrames/Remotion' "$skill"; \
    grep -Fq 'Shotcraft' "$skill"; \
    grep -Fq 'parallel agents' "$skill"; \
    grep -Fq 'aesthetic review' "$skill"; \
    chown -R root:root /anbanai /app/runtime-claude; \
    chmod -R a=rX /anbanai /app/runtime-claude; \
    chmod 0755 /usr/local/bin/anban
ENV CLAUDE_PLUGIN_ROOT=/anbanai ANBAN_VIDEO_USE_ROOT=/opt/video-use PATH=/opt/video-use-venv/bin:$PATH
USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "anban"]
CMD ["job"]

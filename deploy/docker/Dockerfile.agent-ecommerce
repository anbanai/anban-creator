# Ecommerce runtime for managed profile `ecommerce`.
# Content runtimes share Node + the managed bootstrap bundle + the canonical
# plugin tree. This profile additionally provisions python3 for the pinned
# ecommerce upstream scripts; it still has no provider CLI or media toolchain.
# Each profile keeps its own image identity and Dockerfile so packs never
# inherit another pack's runtime.
FROM crpi-671lgv9lrdyll4t9.cn-chengdu.personal.cr.aliyuncs.com/bx_anbanai/node:24.22.0-bookworm-slim AS builder

WORKDIR /app/runtime-claude
COPY runtime-claude/package.json runtime-claude/package-lock.json ./
RUN npm ci
COPY runtime-claude/ ./
RUN npm run build && \
    grep -Fq 'X-Anban-Agent-Contract-Version' dist/bootstrap.js && \
    grep -Fq 'X-Anban-Agent-Pack-Catalog-Digest' dist/bootstrap.js && \
    grep -Fq 'bootstrapHTTPError' dist/bootstrap.js && \
    grep -Fq 'error_code' dist/bootstrap.js && \
    npm prune --omit=dev && \
    test -d node_modules/@anthropic-ai/claude-agent-sdk

FROM crpi-671lgv9lrdyll4t9.cn-chengdu.personal.cr.aliyuncs.com/bx_anbanai/node:24.22.0-bookworm-slim

USER root
# python3 runs the pinned upstream copy-length and final-copy scanners
# (skills/ecommerce-visual-copywriting-skill/scripts). Those scripts are
# stdlib-only, so no virtualenv or third-party packages are provisioned.
RUN set -eux; \
    installed=0; \
    for attempt in 1 2 3; do \
      if apt-get -o Acquire::Retries=5 update && \
        apt-get -o Acquire::Retries=5 install -y --no-install-recommends \
        ca-certificates curl git jq python3 tini; then \
        installed=1; break; \
      fi; \
      echo "apt package installation failed (attempt ${attempt}/3), retrying" >&2; \
      sleep $((attempt * 5)); \
    done; \
    test "$installed" = 1; \
    getent passwd 1000 >/dev/null || { echo >&2 "Node base must provide UID 1000"; exit 1; }; \
    getent group 1000 >/dev/null || { echo >&2 "Node base must provide GID 1000"; exit 1; }; \
    install -d -m 0755 -o 1000 -g 1000 /home/node; \
    install -d -m 0770 -o 1000 -g 1000 /workspace; \
    install -d -m 0750 -o 1000 -g 1000 /workspace/.claude; \
    install -d -m 0700 -o 1000 -g 1000 /run/secrets/anban; \
    ln -sf /usr/bin/python3 /usr/local/bin/python; \
    rm -rf /var/lib/apt/lists/*

COPY --from=builder /app/runtime-claude/node_modules /app/runtime-claude/node_modules
COPY --from=builder /app/runtime-claude/dist /app/runtime-claude/dist
COPY harness/ /anbanai/
COPY deploy/docker/anban-agent-launcher /usr/local/bin/anban

RUN set -eux; \
    if [ -n "$(find /anbanai -type l -print -quit)" ]; then echo >&2 "/anbanai must not contain symlinks"; exit 1; fi; \
    test -f /anbanai/skills/ecommerce-visual-copywriting-skill/SKILL.md || { echo >&2 "/anbanai is missing the ecommerce upstream submodule; run git submodule update --init --recursive harness before building"; exit 1; }; \
    test -f /anbanai/skills/humanizer/SKILL.md || { echo >&2 "/anbanai is missing the humanizer submodule; run git submodule update --init --recursive harness before building"; exit 1; }; \
    chown -R root:root /anbanai /app/runtime-claude; \
    chmod -R a=rX /anbanai /app/runtime-claude; \
    chmod 0755 /usr/local/bin/anban

ENV CLAUDE_PLUGIN_ROOT=/anbanai
ENV HOME=/home/node

USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "anban"]
CMD ["job"]

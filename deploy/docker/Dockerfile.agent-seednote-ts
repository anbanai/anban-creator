FROM node:22-bookworm-slim AS builder

WORKDIR /app/anban-agent
COPY agent-ts/package.json agent-ts/package-lock.json ./
RUN npm ci
COPY agent-ts/ ./
RUN npm run build && npm prune --omit=dev && test -d node_modules/@anthropic-ai/claude-agent-sdk

FROM node:22-bookworm-slim

USER root
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends ca-certificates curl git jq python3 python3-venv tini; \
    getent passwd 1000 >/dev/null || { echo >&2 "Node base must provide UID 1000"; exit 1; }; \
    getent group 1000 >/dev/null || { echo >&2 "Node base must provide GID 1000"; exit 1; }; \
    install -d -m 0755 -o 1000 -g 1000 /home/node /run/secrets/anban; \
    rm -rf /var/lib/apt/lists/*

ARG MCPORTER_VERSION=0.9.0
ENV AGENT_REACH_VENV=/opt/agent-reach-venv
RUN npm install -g "mcporter@${MCPORTER_VERSION}" && mcporter --version && npm cache clean --force && rm -rf /root/.npm
COPY third_party/Agent-Reach/ /app/third_party/Agent-Reach/
RUN set -eux; \
    python3 -m venv "$AGENT_REACH_VENV"; \
    "$AGENT_REACH_VENV/bin/pip" install --no-cache-dir --constraint /app/third_party/Agent-Reach/constraints.txt /app/third_party/Agent-Reach; \
    "$AGENT_REACH_VENV/bin/agent-reach" --version; \
    chown -R root:root /app/third_party/Agent-Reach "$AGENT_REACH_VENV"; \
    chmod -R a=rX /app/third_party/Agent-Reach "$AGENT_REACH_VENV"

COPY --from=builder /app/anban-agent/node_modules /app/anban-agent/node_modules
COPY --from=builder /app/anban-agent/dist /app/anban-agent/dist
COPY plugins/ /anbanai/
COPY deploy/docker/anban-ts-launcher /usr/local/bin/anban
RUN set -eux; \
    if [ -n "$(find /anbanai -type l -print -quit)" ]; then echo >&2 "/anbanai must not contain symlinks"; exit 1; fi; \
    chown -R root:root /anbanai /app/anban-agent; \
    chmod -R a=rX /anbanai /app/anban-agent; \
    chmod 0755 /usr/local/bin/anban

ENV CLAUDE_PLUGIN_ROOT=/anbanai
ENV HOME=/home/node
ENV PATH="${AGENT_REACH_VENV}/bin:${PATH}"

USER 1000:1000
WORKDIR /workspace
ENTRYPOINT ["tini", "--", "anban"]
CMD ["job"]
